<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FreshSave — Log In</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="../css/styles.css" />
</head>

<body>

  <div class="auth-wrapper">
    <div class="auth-box">
      <div class="auth-logo" onclick="goHome()" style="cursor:pointer"><i class="bi bi-leaf-fill"></i> FreshSave</div>
      <h2 style="font-size:20px;font-weight:700;margin-bottom:4px;text-align:center">Welcome back</h2>
      <p style="font-size:13px;color:var(--gray);text-align:center;margin-bottom:22px">Sign in to your account to
        continue</p>

      <div class="auth-error" id="login-error"></div>

      <div class="form-group">
        <label><i class="bi bi-envelope-fill"></i> Email Address</label>
        <input type="email" id="login-email" placeholder="you@example.com" />
      </div>
      <div class="form-group">
        <label><i class="bi bi-lock-fill"></i> Password</label>
        <input type="password" id="login-pass" placeholder="Your password" />
      </div>
      <button id="login-btn" class="btn btn-green" style="width:100%;margin-top:4px" onclick="doLogin()">
        Log In <i class="bi bi-arrow-right-circle-fill"></i>
      </button>

      <div class="auth-divider" style="margin-top:18px">
        Don't have an account?
        <span onclick="goSignup()" style="color:var(--green);font-weight:600;cursor:pointer">Sign up free</span>
      </div>
      <div style="text-align:center;margin-top:10px">
        <span onclick="goHome()" style="font-size:13px;color:var(--gray);cursor:pointer">
          <i class="bi bi-arrow-left"></i> Back to homepage
        </span>
      </div>
    </div>
  </div>

  <div id="fs-toast"></div>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/bcryptjs/2.4.3/bcrypt.min.js"></script>
  <script src="../js/config.js"></script>
  <script src="../js/api.js"></script>
  <script src="../js/app.js"></script>
  <script src="../js/login.js"></script>
</body>

</html>